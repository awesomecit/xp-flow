{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./src/**)",
      "Edit(./test/**)",
      "Edit(./features/**)",
      "Edit(./docs/**)",
      "Edit(./TODO.md)",
      "Edit(./ROADMAP.md)",
      "Edit(./CHANGELOG.md)",
      "Write(./.xpflow/**)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm test)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(//Users/antoniocittadino/Repos/**)",
      "Edit(//Users/antoniocittadino/Repos/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(./.git/**)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(cd /Users/antoniocittadino/Repos:*)",
      "Bash(curl:*)",
      "Bash(sudo:*)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .xpflow/events.jsonl ] && grep '\"esito\":\"azione_manuale\"' .xpflow/events.jsonl | while read -r e; do ts=$(echo \"$e\" | sed -n 's/.*\"ts\":\"\\([^\"]*\\)\".*/\\1/p'); grep -q \"\\\"cmd\\\":\\\"manual_done\\\".*\\\"ref\\\":\\\"$ts\\\"\" .xpflow/events.jsonl || echo \"⚠️ AZIONE MANUALE PENDENTE: $e\"; done || true"
          }
        ]
      }
    ]
  }
}
